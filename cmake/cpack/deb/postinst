#!/bin/sh
set -e
if [ "$1" = "configure" ] && [ -x "`which update-menus 2>/dev/null`" ]; then
	update-menus
fi

if [ ! -f "/etc/sudoers.d/020_kodi" ]; then
tee -a /etc/sudoers.d/020_kodi > /dev/null 2>&1 <<_EOF_
Cmnd_Alias KODI_VT = /bin/fgconsole, /bin/chvt *

%video ALL = (root) NOPASSWD: KODI_VT
_EOF_
fi

if [ ! -f "/etc/udev/rules.d/99-kodi.rules" ]; then
tee -a /etc/udev/rules.d/99-kodi.rules > /dev/null 2>&1 <<_EOF_
SUBSYSTEM=="drm", GROUP="video", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="tty[0-9]*", GROUP="tty", MODE="0660"
_EOF_
fi

if [ "$1" = "configure" ]; then
  # Ensure polkit directories exist
  mkdir -p /etc/polkit-1/rules.d

  cat <<'EOF' > /etc/polkit-1/rules.d/50-kodi.rules
// PolicyKit override for Kodi: allow users in plugdev group to reboot, shutdown, mount
polkit.addRule(function(action, subject) {
  if (subject.isInGroup("plugdev")) {
    var allowed = [
      "org.freedesktop.consolekit.*",
      "org.freedesktop.upower.*",
      "org.freedesktop.login1.*",
      "org.freedesktop.udisks.*"
    ];
    for (var i = 0; i < allowed.length; i++) {
      var regex = new RegExp("^" + allowed[i].replace(".", "\\.").replace("*", ".*") + "$");
      if (regex.test(action.id)) {
        return polkit.Result.YES;
      }
    }
  }
  return polkit.Result.NOT_HANDLED;
});
EOF

  chmod 0644 /etc/polkit-1/rules.d/50-kodi.rules
  # optional: reload polkit daemon if supported
  if command -v systemctl >/dev/null; then
    systemctl reload polkitd || true
  fi
fi

