+.if \depth == 8
+        vsetvli   zero, zero, e16, mf2, ta, ma
+.else
+        vsetvli   zero, zero, e32, m1, ta, ma
+.endif
+        vmsne.vi  v1, v16, 0
+        vsetvli   zero, zero, e8, mf4, ta, ma
+        vmseq.vi  v2, v12, 1
+        vmsne.vi  v0, v12, 0
+        vmand.mm  v1, v1, v2
+        vmv.x.s   s2, v0
+        vmv.x.s   a7, v1
+        zext.h  s2, s2
+        slli    a7, a7, 16
+        li      s1, 4
+        or      s2, s2, a7
+        mv      s4, a0
+        mv      s5, a1
+        mv      a1, a2
+        mv      a2, a3
+1:
+        andi    t0, s2, 1
+        addi    s1, s1, -1
+        beqz    t0, 3f     # if (nnz)
+        lw      t2, (s5)   # block_offset[i]
+        bexti   t1, s2, 16
+        add     a0, s4, t2
+        bnez    t1, 2f    # if (nnz == 1 && block[i * 16])
+        jal     .Lidct8_add_\depth\()_rvv
+.if \depth == 8
+        j       3f
+.else
+        j       4f        # idct8_add_16 updates a1
+.endif
+2:
+        jal     ff_h264_idct8_dc_add_\depth\()_rvv
+3:
+        addi    a1, a1, 4 * 16 * 2 * (\depth / 8)
+4:
+        srli    s2, s2, 1
+        addi    s5, s5, 4 * 4
+        bnez    s1, 1b
+
+        ld      s5, 40(sp)
+        ld      s4, 32(sp)
+        ld      s2, 24(sp)
+        ld      s1, 16(sp)
+        ld      ra,  8(sp)
+        ld      s0,  0(sp)
+        addi    sp, sp, 48
+        ret
+endfunc
+#endif
+.endr
