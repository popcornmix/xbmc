new file mode 100644
index 0000000000..32a345beec
--- /dev/null
+++ b/libavcodec/progressframe.h
@@ -0,0 +1,157 @@
+/*
+ * Copyright (c) 2022 Andreas Rheinhardt <andreas.rheinhardt@outlook.com>
+ *
