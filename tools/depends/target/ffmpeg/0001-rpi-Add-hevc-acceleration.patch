+        vsetvli   zero, zero, e16, m4, ta, ma
+        vnsra.wi  v0, v16, 15 - 6
+        vnsra.wi  v4, v24, 15 - 6
+        vse16.v   v0, (a0)
+        sh1add    a0, t0, a0
+        vse16.v   v4, (a1)
+        sh1add    a1, t0, a1
