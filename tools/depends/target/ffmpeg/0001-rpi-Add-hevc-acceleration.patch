+1:
+        lw      t2, 16(a6) # GU
+        lw      t5, 28(a6) # GV
+        li      a6, 0xff
+        li      a7, (256 << 15) + (1 << (15 - 6))
+2:
+        vsetvli     t0, a5, e32, m4, ta, ma
+        vlseg2e32.v v0, (a3)
+        sub         a5, a5, t0
+        .if     \high
+        vsrl.vi     v8, v0, 24
+        vsrl.vi     v12, v4, 24
+        .else
+        vand.vx     v8, v0, a6
