+        vand.vx     v28, v28, a6
+        vadd.vv     v8, v8, v12
+        vadd.vv     v16, v16, v20
+        vadd.vv     v24, v24, v28
+        vmul.vx     v0, v8, t1
+        vmul.vx     v4, v8, t4
