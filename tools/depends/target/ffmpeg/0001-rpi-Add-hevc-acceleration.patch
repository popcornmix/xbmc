-static int FUNC(lmcs_sum_samples)(const pixel *start, ptrdiff_t stride, const int avail, const int target_size)
-{
-    const int size = FFMIN(avail, target_size);
-    int sum = 0;
-    for (int i = 0; i < size; i++) {
-        sum += *start;
-        start += stride;
-    }
-    sum += *(start - stride) * (target_size - size);
-    return sum;
-}
