-        k[i] = FFMAX(1, 3 + x -y);
-        sign = a[i] < 0 ? -1 : (a[i] > 0);
-        a[i] = ((3 + x - y) < 1) ?  sign * 15 : a[i];
-        b[i] = min[i + 1] - ((a[i] * min[0]) >> k[i]);
-    }
-
-}
