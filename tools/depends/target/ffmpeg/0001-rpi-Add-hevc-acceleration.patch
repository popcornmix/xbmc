+}
+
+static void check_pix_norm1(MpegvideoEncDSPContext *c)
+{
+    LOCAL_ALIGNED_16(uint8_t, src, [16 * 16]);
+
+    declare_func(int, const uint8_t *pix, ptrdiff_t line_size);
+
+    randomize_buffers(src, 16 * 16);
+
+    for (int n = 0; n < 2; n++) {
