diff --git a/libavformat/conformenc.c b/libavformat/conformenc.c
new file mode 100644
index 0000000000..1fcc873916
--- /dev/null
+++ b/libavformat/conformenc.c
@@ -0,0 +1,488 @@
+/*
+ * Copyright (c) 2020 John Cox for Raspberry Pi Trading
+ *
