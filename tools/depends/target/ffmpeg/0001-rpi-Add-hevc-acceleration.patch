-static int pps_add_ctus(VVCPPS *pps, int *off, const int ctu_x, const int ctu_y,
-    const int w, const int h)
-{
-    int start = *off;
-    for (int y = 0; y < h; y++) {
-        for (int x = 0; x < w; x++) {
-            pps->ctb_addr_in_slice[*off] = ctu_rs(ctu_x + x, ctu_y + y, pps);
-            (*off)++;
-        }
-    }
-    return *off - start;
-}
