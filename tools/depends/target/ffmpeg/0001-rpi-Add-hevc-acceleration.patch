+int ff_vvc_sao_band_position_decode(VVCLocalContext *lc)
+{
+    int value = get_cabac_bypass(&lc->ep->cc);
+
+    for (int i = 0; i < 4; i++)
+        value = (value << 1) | get_cabac_bypass(&lc->ep->cc);
+    return value;
+}
