-    if (sb_flag){
-        if (X == 0) {
-            if (temp_col.pred_flag & PF_L0)
-                return CHECK_MVSET(0);
-            else if (ff_vvc_no_backward_pred_flag(lc) && (temp_col.pred_flag & PF_L1))
