-static void FUNC(put_ciip)(uint8_t *_dst, const ptrdiff_t _dst_stride,
-    const int width, const int height,
-    const uint8_t *_inter, const ptrdiff_t _inter_stride, const int intra_weight)
-{
-    pixel *dst                = (pixel *)_dst;
