-static void alf_coeff_cc(int16_t *coeff,
-    const uint8_t *mapped_abs, const uint8_t *sign)
-{
-    for (int i = 0; i < ALF_NUM_COEFF_CC; i++) {
-        int c = mapped_abs[i];
-        if (c)
-            c = (1 - 2 * sign[i]) * (1 << (c - 1));
-        coeff[i] = c;
-    }
-}
