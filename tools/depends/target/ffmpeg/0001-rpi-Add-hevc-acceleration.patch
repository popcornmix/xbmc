-static void hls_mvd_coding(VVCLocalContext *lc, Mv* mvd)
-{
-    int16_t mv[2];
-
-    for (int i = 0; i < 2; i++) {
-        mv[i] = ff_vvc_abs_mvd_greater0_flag(lc);
-    }
-
-    for (int i = 0; i < 2; i++) {
-        if (mv[i])
-            mv[i] += ff_vvc_abs_mvd_greater1_flag(lc);
-    }
-
-    for (int i = 0; i < 2; i++) {
-        if (mv[i] > 0) {
-            if (mv[i] == 2)
-                mv[i] += ff_vvc_abs_mvd_minus2(lc);
-            mv[i] = (1 - 2 * ff_vvc_mvd_sign_flag(lc)) * mv[i];
-        }
-    }
-    mvd->x = mv[0];
-    mvd->y = mv[1];
-}
