+        vmul.vx     v16, v16, a4
+        vmul.vx     v24, v24, a4
+        vsadd.vx    v16, v16, a5
+        vsadd.vx    v24, v24, a5
+        vmax.vx     v16, v16, zero
+        vmax.vx     v24, v24, zero
+        vsetvli     zero, zero, e8, m4, ta, ma
+        vnclipu.wx  v0, v16, a3
+        vnclipu.wx  v4, v24, a3
+        vssseg2e8.v v0, (t0), a1
+        addi    t0, t0, 2
+        bnez    t6, 2b
+
+        mul     t3, a1, t2
+        sub     a2, a2, t2
+        add     a0, a0, t3
+        bnez    a2, 1b
