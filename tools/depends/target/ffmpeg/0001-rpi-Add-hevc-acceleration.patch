-            "sw      %[temp1],    4(%[dst])             \n\t"
-            "sw      %[temp2],    8(%[dst])             \n\t"
-            "sw      %[temp3],    12(%[dst])            \n\t"
-            "sw      %[temp4],    16(%[dst])            \n\t"
-            "sw      %[temp5],    20(%[dst])            \n\t"
-            "sw      %[temp6],    24(%[dst])            \n\t"
-            "sw      %[temp7],    28(%[dst])            \n\t"
-            "sw      $0,          2304(%[dst])          \n\t"
-            "sw      $0,          2308(%[dst])          \n\t"
-            "sw      $0,          2312(%[dst])          \n\t"
-            "sw      $0,          2316(%[dst])          \n\t"
-            "sw      $0,          2320(%[dst])          \n\t"
-            "sw      $0,          2324(%[dst])          \n\t"
