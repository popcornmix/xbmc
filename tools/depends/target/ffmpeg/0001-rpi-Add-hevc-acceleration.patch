-static void vector_pow43(int *coefs, int len)
-{
-    int i, coef;
-
-    for (i=0; i<len; i++) {
-        coef = coefs[i];
-        if (coef < 0)
-            coef = -(int)ff_cbrt_tab_fixed[(-coef) & 8191];
-        else
-            coef =  (int)ff_cbrt_tab_fixed[  coef  & 8191];
-        coefs[i] = coef;
-    }
-}
