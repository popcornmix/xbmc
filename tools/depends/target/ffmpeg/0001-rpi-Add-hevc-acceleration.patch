-            return more_data;
-
-        if (more_data && x1 < s->ps.sps->width) {
-            more_data = hls_coding_quadtree(lc, x1, y0, log2_cb_size - 1, cb_depth + 1);
-            if (more_data < 0)
-                return more_data;
-        }
-        if (more_data && y1 < s->ps.sps->height) {
-            more_data = hls_coding_quadtree(lc, x0, y1, log2_cb_size - 1, cb_depth + 1);
