+    get_left_top(lc, &left, &top, x0, y0, fc->tab.cpm[ch_type], fc->tab.cpm[ch_type]);
+    inc = left == MODE_INTRA || top == MODE_INTRA;
+    return GET_CABAC(NON_INTER_FLAG + inc);
+}
