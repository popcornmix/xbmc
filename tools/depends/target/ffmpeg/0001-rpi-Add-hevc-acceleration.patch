-static void FUNC(apply_prof_uni_w)(uint8_t *_dst, const ptrdiff_t _dst_stride,
-    const int16_t *src, const int16_t *diff_mv_x, const int16_t *diff_mv_y,
-    const int denom, const int wx, const int _ox)
-{
