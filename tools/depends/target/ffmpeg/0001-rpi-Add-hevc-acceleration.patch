-
-    ff_refstruct_replace(&sc->ref, unit->content_ref);
-
-    if (is_first_slice) {
-        ret = frame_start(s, fc, sc);
-        if (ret < 0)
-            return ret;
-    } else if (fc->ref) {
-        if (!IS_I(sh->r)) {
-            ret = ff_vvc_slice_rpl(s, fc, sc);
-            if (ret < 0) {
-                av_log(fc->log_ctx, AV_LOG_WARNING,
