-static av_always_inline
-uint8_t get_inc(VVCLocalContext *lc, const uint8_t *ctx)
-{
-    uint8_t left = 0, top = 0;
-    get_left_top(lc, &left, &top, lc->cu->x0, lc->cu->y0, ctx, ctx);
-    return left + top;
-}
