+                    CHECK(FUNC(colour_mapping_octants)(ctx, rw, current, inp_depth + 1,
+                                                       idx_y + part_num_y * k * inp_length / 2,
+                                                       idx_cb + m * inp_length / 2,
+                                                       idx_cr + n * inp_length / 2,
+                                                       inp_length / 2));
