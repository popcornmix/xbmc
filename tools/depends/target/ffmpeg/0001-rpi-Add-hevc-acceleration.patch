-    for (int i = 0, j = 0; i < r->num_tile_columns; i++) {
-        pps->col_bd[i] = j;
-        j += r->col_width_val[i];
-        for (int k = pps->col_bd[i]; k < j; k++)
-            pps->ctb_to_col_bd[k] = pps->col_bd[i];
