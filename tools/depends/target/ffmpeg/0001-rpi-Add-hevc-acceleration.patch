-        mov             x11, x1                    // copy base src
-1:      // new line
-        mov             x14, x5                    // copy width
-        sub             x12, x11, x4               // src_a (prev) = src - sao_edge_pos
-        add             x13, x11, x4               // src_b (next) = src + sao_edge_pos
-2:      // process 16 bytes
-        ld1             {v3.16b}, [x11], #16       // load src
-        ld1             {v4.16b}, [x12], #16       // load src_a (prev)
