-    pkt->buf = av_buffer_create(data, size + AV_INPUT_BUFFER_PADDING_SIZE,
-                                av_buffer_default_free, NULL, 0);
-    if (!pkt->buf)
-        return AVERROR(ENOMEM);
-
-    pkt->data = data;
