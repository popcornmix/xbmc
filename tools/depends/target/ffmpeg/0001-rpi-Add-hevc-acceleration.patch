+#include "libavutil/riscv/asm.S"
+
+#if __riscv_xlen >= 64
+func ff_put_pixels8x8_rvi
+        lpad    0
+.rept 8
+        ld t0, (a1)
+        sd t0, (a0)
+        add a1, a1, a2
+        add a0, a0, a2
+.endr
+
+        ret
+endfunc
+
+func ff_put_pixels16x16_rvi
+        lpad    0
+.rept 16
+        ld t0, (a1)
+        ld t1, 8(a1)
+        sd t0, (a0)
+        sd t1, 8(a0)
+        add a1, a1, a2
+        add a0, a0, a2
+.endr
+
+        ret
+endfunc
+#endif
