-        "1:                                                   \n\t"
-            "sw     $0,              0(%[p_saved_ltp])        \n\t"
-            "sw     $0,              4(%[p_saved_ltp])        \n\t"
-            "sw     $0,              8(%[p_saved_ltp])        \n\t"
-            "sw     $0,              12(%[p_saved_ltp])       \n\t"
