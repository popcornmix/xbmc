-    const int first_ctb_in_slice = !ctu_idx;
-    const int first_ctb_in_tile  = rx == pps->ctb_to_col_bd[rx] && ry == pps->ctb_to_row_bd[ry];
-
-    if (first_ctb_in_slice|| first_ctb_in_tile) {
-        if (lc->sc->nb_eps == 1 && !first_ctb_in_slice)
-            ret = cabac_reinit(lc);
-        if (!ret)
-            cabac_init_state(lc);
-    }
-    return ret;
-}
