-static int get_local_sum(const int *level, const int w, const int h,
-    const int xc, const int yc, const int hist_value)
-{
-    int loc_sum = 3 * hist_value;
-    level += w * yc + xc;
-    if (xc < w - 1) {
-        loc_sum += level[1];
-        if (xc < w - 2)
-            loc_sum += level[2] - hist_value;
-        if (yc < h - 1)
-            loc_sum += level[w + 1] - hist_value;
-    }
-    if (yc < h - 1) {
