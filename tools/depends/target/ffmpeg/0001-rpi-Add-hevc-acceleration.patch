-    if (cu->pred_mode == MODE_IBC)
-    {
-        ff_vvc_update_hmvp(lc, mi);
-    } else if (!pu->merge_gpm_flag && !pu->inter_affine_flag && !pu->merge_subblock_flag) {
-        refine_regular_subblock(lc);
-        ff_vvc_update_hmvp(lc, mi);
