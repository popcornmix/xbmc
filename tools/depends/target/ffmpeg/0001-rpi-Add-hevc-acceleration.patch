diff --git a/libavcodec/libvvenc.c b/libavcodec/libvvenc.c
new file mode 100644
index 0000000000..ece9badb19
--- /dev/null
+++ b/libavcodec/libvvenc.c
@@ -0,0 +1,491 @@
