-
-    dst += MAX_PB_SIZE;
-    src += src_stride;
-
-    for (int i = 0; i < height; i++) {
-        dst[0] = src[0] << shift;
-        dst[1 + width] = src[1 + width] << shift;
-        dst += MAX_PB_SIZE;
-        src += src_stride;
