+    uint8_t extension_present;
+    uint8_t scaling_list_enabled;
+    uint8_t amp_enabled;
+    uint8_t sao_enabled;
+    uint8_t long_term_ref_pics_present;
+    uint8_t temporal_mvp_enabled;
