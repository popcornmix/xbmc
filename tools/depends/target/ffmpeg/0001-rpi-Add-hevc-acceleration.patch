-    const int ry        = y0 >> sps->ctb_log2_size_y;
-    CTU *ctu            = fc->tab.ctus + ry * pps->ctb_width + rx;
-    CodingUnit *cu      = ff_refstruct_pool_get(fc->cu_pool);
-
-    if (!cu)
-        return NULL;
-    cu->next = NULL;
-
-    if (lc->cu)
-        lc->cu->next = cu;
-    else
-        ctu->cus = cu;
-    lc->cu = cu;
-
-    return cu;
