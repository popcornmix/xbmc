-#define TC_CALC(qp, bs)                                                 \
-    tctable[av_clip((qp) + DEFAULT_INTRA_TC_OFFSET * ((bs) - 1) +       \
-                    (tc_offset & -2),                                   \
-                    0, MAX_QP + DEFAULT_INTRA_TC_OFFSET)]
