+    coeffs[58 * stride] = E[5]  - O[5];
+    coeffs[59 * stride] = E[4]  - O[4];
+    coeffs[60 * stride] = E[3]  - O[3];
+    coeffs[61 * stride] = E[2]  - O[2];
+    coeffs[62 * stride] = E[1]  - O[1];
+    coeffs[63 * stride] = E[0]  - O[0];
