+static inline int ff_dovi_rpu_extension_is_static(int level)
+{
+    switch (level) {
+    case 6:
+    case 10:
+    case 32: /* reserved as static by spec */
+    case 254:
+    case 255:
+        return 1;
+    default:
+        return 0;
+    }
