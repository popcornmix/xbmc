diff --git a/libavcodec/riscv/h263dsp_rvv.S b/libavcodec/riscv/h263dsp_rvv.S
new file mode 100644
index 0000000000..e9cb4ec07b
--- /dev/null
+++ b/libavcodec/riscv/h263dsp_rvv.S
@@ -0,0 +1,101 @@
+/*
+ * Copyright © 2024 Rémi Denis-Courmont.
+ *
